# Estágio 1: Build da aplicação com otimização de memória
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN npx ng build --configuration production

# Estágio 2: Servidor estático leve (Nginx)
FROM nginx:alpine

# Copia os arquivos compilados (atenção ao caminho /browser)
COPY --from=build /app/dist/glitch_frontend/browser /usr/share/nginx/html

# Configura o Nginx para lidar com as rotas do Angular (Prevenção de Erro 404)
RUN echo 'server { listen 80; location / { root /usr/share/nginx/html; index index.html index.htm; try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf

# Não é necessário CMD. O Nginx inicia automaticamente.