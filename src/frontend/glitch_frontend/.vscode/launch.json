{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular: Debug no Brave",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "/usr/bin/brave-browser", 
      "userDataDir": "${workspaceFolder}/.vscode/brave-debug",
      "preLaunchTask": "npm: start"
    }
  ]
}